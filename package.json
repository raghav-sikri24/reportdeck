{
  "name": "reportdeck",
  "version": "0.2.0",
  "description": "Backend-driven React charts, KPI cards, tables and reports with one-click PNG, SVG, CSV, Excel and PDF export \u2014 plus an AI chart picker for raw data.",
  "keywords": [
    "react",
    "charts",
    "echarts",
    "dashboard",
    "reports",
    "data-visualization",
    "export",
    "pdf",
    "excel",
    "csv",
    "ai",
    "auto-chart",
    "chart-recommendation",
    "gemini",
    "openai",
    "claude"
  ],
  "homepage": "https://github.com/raghav-sikri24/reportdeck#readme",
  "bugs": {
    "url": "https://github.com/raghav-sikri24/reportdeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghav-sikri24/reportdeck.git"
  },
  "author": "Raghav Sikri <raghav2420@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./export": {
      "import": {
        "types": "./dist/export.d.ts",
        "default": "./dist/export.js"
      },
      "require": {
        "types": "./dist/export.d.cts",
        "default": "./dist/export.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && publint"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@anthropic-ai/sdk": ">=1.0.0",
    "@google/genai": ">=2.3.0",
    "openai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@google/genai": "^2.31.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "openai": "^7.45.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.1",
  "publishConfig": {
    "access": "public"
  }
}
